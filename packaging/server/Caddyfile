{
    admin off
    auto_https off
}
https://{$PUBLISHER_LISTEN_IP}:{$PUBLISHER_HTTPS_PORT} {
    bind {$PUBLISHER_LISTEN_IP}
    tls data/private/server.crt data/private/server.key
    route {
        @foreign_origin {
            header Origin *
            not header Origin {$PUBLISHER_ORIGIN}
        }
        respond @foreign_origin "Invalid request origin" 403
        @cross_site {
            header Sec-Fetch-Site cross-site
            method POST PUT PATCH DELETE
        }
        respond @cross_site "Cross-site request denied" 403
        basic_auth {
            {$PUBLISHER_LOGIN_USER} {$PUBLISHER_PASSWORD_HASH}
        }
        reverse_proxy 127.0.0.1:{$PUBLISHER_BACKEND_PORT} {
            header_up Host 127.0.0.1:{$PUBLISHER_BACKEND_PORT}
            header_up Origin http://127.0.0.1:{$PUBLISHER_BACKEND_PORT}
            header_up -Authorization
        }
    }
}
